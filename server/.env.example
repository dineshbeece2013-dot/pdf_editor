# ---------------------------------------------------------------------------
# PDF Editor Pro — backend configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Public origin of the app (used for cookie "secure" decisions and CORS).
APP_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
DATABASE_URL=postgres://pdfpro:pdfpro@localhost:5432/pdfpro

# 64 hex chars. Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-64-random-hex-chars

# 64 hex chars. Encrypts the Razorpay key secret at rest (AES-256-GCM).
# Generate with the same command as SESSION_SECRET. Rotating this makes
# previously-stored secrets unreadable, so re-enter them after rotating.
RAZORPAY_ENCRYPTION_KEY=replace-me-with-64-random-hex-chars

# Bootstrap admin, created by `npm run seed:admin`. This is the ONLY way an
# admin account is ever created — registration always produces role='user'.
ADMIN_EMAIL=admin@pdfpro.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# Session lifetime in days.
SESSION_TTL_DAYS=7

# Razorpay keys (optional — can also be set later from the admin dashboard,
# which stores them encrypted in PostgreSQL). The secret is NEVER sent to the
# browser; the dashboard only ever receives a "is a secret configured?" flag.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# Sandbox escape hatch for the "Complete demo payment" button in the upgrade
# modal. It grants Pro WITHOUT collecting money, so it must stay false in
# production. Even when enabled the grant is performed server-side.
ALLOW_DEMO_PAYMENTS=true
